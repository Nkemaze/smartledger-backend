# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/smartledger?schema=public"

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- SMS / OTP (Africa's Talking or Twilio) ---
# How OTP codes are delivered: whatsapp (default) | sms | both
OTP_CHANNEL=whatsapp
SMS_PROVIDER=africastalking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- File Storage (S3 or Cloudflare R2) ---
STORAGE_PROVIDER=r2
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=

# --- WhatsApp Business (default: Meta Cloud API) ---
# Master switch: set to false to disable all WhatsApp sending.
WHATSAPP_ENABLED=true
# Provider: meta (Cloud API, free, no monthly fee) | 360dialog (BSP, ~€49/mo) | unipile (unofficial, hosted) | baileys (unofficial, in-process, free)
WHATSAPP_PROVIDER=meta
# Meta Cloud API: long-lived access token from the Meta Developer app
WHATSAPP_ACCESS_TOKEN=
# Phone number ID of the WhatsApp number linked to your WABA (both providers)
WHATSAPP_PHONE_NUMBER_ID=
# 360dialog only: instance API key
WHATSAPP_API_KEY=
# Webhook security (Meta)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_a_random_string
WHATSAPP_APP_SECRET=
# Required templates (create in the WhatsApp portal):
#   smartledger_otp (authentication)      -> {{1}} = code
#   daily_sales_summary (utility)         -> {{1}} business, {{2}} income, {{3}} expenses, {{4}} profit
#   low_stock_alert (utility)             -> {{1}} business, {{2}} product, {{3}} remaining

# --- Unipile (WHATSAPP_PROVIDER=unipile) ---
# No WABA/templates needed: connect a real WhatsApp number via QR in the
# Unipile dashboard, then copy the API key and the connected account id.
# The base URL is a DEDICATED host per account, e.g. https://api58.unipile.com:18861
# (check the cURL examples in your Unipile dashboard for yours).
# Templates are sent as plain text. Unofficial automation - fine for dev/MVP.
UNIPILE_API_KEY=
UNIPILE_BASE_URL=https://apiXX.unipile.com:1XXXX
UNIPILE_ACCOUNT_ID=

# --- Baileys (WHATSAPP_PROVIDER=baileys) ---
# Unofficial in-process WhatsApp Web client. Pair once: set the phone number,
# start the server, read the pairing code from the console. Session persists
# in the auth dir. Use a disposable number - restriction risk applies.
BAILEYS_AUTH_DIR=./baileys-auth
BAILEYS_PAIRING_PHONE=

# End-of-day WhatsApp summary schedule (cron + IANA timezone)
DAILY_SUMMARY_CRON=0 20 * * *
DAILY_SUMMARY_TZ=Africa/Douala

# --- Email (SMTP) for email verification codes ---
# Works with Gmail (smtp.gmail.com:587 + app password), Brevo, Resend SMTP, etc.
# Leave empty in dev: codes are logged to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="SmartLedger <no-reply@example.com>"

# --- AI Advisor (Hosted LLM) ---
# Provider: anthropic (default) | gemini (free tier)
#   - Gemini: get a free key at https://aistudio.google.com/apikey
#     model e.g. gemini-3.5-flash or gemini-3.1-flash-lite (free tier)
#   - Anthropic: key from https://console.anthropic.com
#     model e.g. claude-sonnet-4-5
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
